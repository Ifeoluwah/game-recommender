# Only needed for `npm run generate` and `npm run build:index` with the OpenAI provider.
# The service itself never calls a model at request time.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Only text-embedding-3-small has a score threshold in config/service.json. The service refuses an index
# built with any other embedding model until that model gets its own threshold (spec 05 §6.3).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
